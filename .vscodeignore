# Everything the extension needs at runtime is bundled into dist/ — the
# extension host code, the webview bundle (with the ImageMagick engine JS), and
# magick.wasm copied there at build time. So the whole node_modules tree,
# including the old per-platform native binaries, is excluded. That drops the
# .vsix from ~88 MB to ~17 MB.
node_modules/**
